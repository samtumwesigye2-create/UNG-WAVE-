[Unit]
Description=UNG-WAVE UGANET LINK256 Control Engine
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ung-wave
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ung-wave/.venv/bin/uvicorn edge.main:app --host 0.0.0.0 --port 8256
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
